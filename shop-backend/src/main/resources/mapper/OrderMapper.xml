<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shop.mapper.OrderMapper">

    <resultMap id="OrderResultMap" type="Order">
        <id property="id" column="id"/>
        <result property="orderNo" column="order_no"/>
        <result property="userId" column="user_id"/>
        <result property="totalPrice" column="total_price"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="payTime" column="pay_time"/>
        <result property="cancelTime" column="cancel_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <select id="findById" resultMap="OrderResultMap">
        SELECT * FROM `order` WHERE id = #{id}
    </select>

    <select id="findByOrderNo" resultMap="OrderResultMap">
        SELECT * FROM `order` WHERE order_no = #{orderNo}
    </select>

    <select id="findByUserId" resultMap="OrderResultMap">
        SELECT * FROM `order` WHERE user_id = #{userId} ORDER BY created_at DESC
    </select>

    <select id="findByUserIdWithFilter" resultType="com.shop.vo.OrderListItemVO">
        SELECT
            o.id,
            o.order_no,
            o.total_price,
            o.status,
            o.created_at,
            o.pay_time,
            (SELECT COUNT(*) FROM order_item oi WHERE oi.order_id = o.id) AS item_count
        FROM `order` o
        WHERE o.user_id = #{userId}
        <if test="status != null and status != ''">
            AND o.status = #{status}
        </if>
        ORDER BY o.created_at DESC
    </select>

    <select id="findAll" resultMap="OrderResultMap">
        SELECT * FROM `order` ORDER BY created_at DESC
    </select>

    <select id="existsByOrderNo" resultType="boolean">
        SELECT COUNT(1) > 0 FROM `order` WHERE order_no = #{orderNo}
    </select>

    <insert id="insert" parameterType="Order" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `order` (order_no, user_id, total_price, status, created_at)
        VALUES (#{orderNo}, #{userId}, #{totalPrice}, #{status}, NOW())
    </insert>

    <update id="update" parameterType="Order">
        UPDATE `order`
        <set>
            <if test="totalPrice != null">total_price = #{totalPrice},</if>
            <if test="status != null">status = #{status},</if>
            <if test="payTime != null">pay_time = #{payTime},</if>
            <if test="cancelTime != null">cancel_time = #{cancelTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM `order` WHERE id = #{id}
    </delete>

</mapper>
