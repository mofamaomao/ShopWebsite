<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shop.mapper.OrderItemMapper">

    <resultMap id="OrderItemResultMap" type="OrderItem">
        <id property="id" column="id"/>
        <result property="orderId" column="order_id"/>
        <result property="productId" column="product_id"/>
        <result property="quantity" column="quantity"/>
        <result property="price" column="price"/>
        <result property="productName" column="product_name"/>
        <result property="productImg" column="product_img"/>
        <result property="subtotal" column="subtotal"/>
    </resultMap>

    <insert id="insert" parameterType="OrderItem" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO order_item (order_id, product_id, quantity, price, product_name, product_img, subtotal)
        VALUES (#{orderId}, #{productId}, #{quantity}, #{price},
                #{productName}, #{productImg}, #{subtotal})
    </insert>

    <select id="findByOrderId" resultMap="OrderItemResultMap">
        SELECT * FROM order_item WHERE order_id = #{orderId}
    </select>

</mapper>
