<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shop.mapper.AddressMapper">

    <resultMap id="AddressResultMap" type="com.shop.entity.Address">
        <id     property="id"        column="id"/>
        <result property="userId"    column="user_id"/>
        <result property="receiver"  column="receiver"/>
        <result property="phone"     column="phone"/>
        <result property="province"  column="province"/>
        <result property="city"      column="city"/>
        <result property="district"  column="district"/>
        <result property="detail"    column="detail"/>
        <result property="isDefault" column="is_default"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 默认地址排第一，然后按创建时间降序 -->
    <select id="findByUserId" resultMap="AddressResultMap">
        SELECT * FROM address WHERE user_id = #{userId}
        ORDER BY is_default DESC, created_at DESC
    </select>

    <select id="findById" resultMap="AddressResultMap">
        SELECT * FROM address WHERE id = #{id}
    </select>

    <select id="countByUserId" resultType="int">
        SELECT COUNT(*) FROM address WHERE user_id = #{userId}
    </select>

    <select id="findLatestByUserId" resultMap="AddressResultMap">
        SELECT * FROM address WHERE user_id = #{userId}
        ORDER BY created_at DESC LIMIT 1
    </select>

    <insert id="insert" parameterType="com.shop.entity.Address"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO address
          (user_id, receiver, phone, province, city, district, detail, is_default, created_at)
        VALUES
          (#{userId}, #{receiver}, #{phone}, #{province}, #{city}, #{district},
           #{detail}, #{isDefault}, NOW())
    </insert>

    <update id="update" parameterType="com.shop.entity.Address">
        UPDATE address
        <set>
            <if test="receiver  != null">receiver  = #{receiver},</if>
            <if test="phone     != null">phone     = #{phone},</if>
            <if test="province  != null">province  = #{province},</if>
            <if test="city      != null">city      = #{city},</if>
            <if test="district  != null">district  = #{district},</if>
            <if test="detail    != null">detail    = #{detail},</if>
            <if test="isDefault != null">is_default = #{isDefault},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM address WHERE id = #{id}
    </delete>

    <update id="clearDefaultByUserId">
        UPDATE address SET is_default = 0 WHERE user_id = #{userId}
    </update>

    <update id="setDefaultById">
        UPDATE address SET is_default = 1 WHERE id = #{id}
    </update>

</mapper>
